# ============================================================================
# 环境变量模板
# ----------------------------------------------------------------------------
# 用法：复制本文件为 .env，再填入真实值。
#       .env 已被 .gitignore 忽略，严禁提交至仓库（项目文档 8.6 / 9.4）。
# 说明：本文件中的所有值均为占位符，不含任何真实凭据。
#
# ⚠️ 这里只允许出现 app/core/config.py 里声明过的字段名。
#    Settings 的 model_config 为 extra="ignore"（多写的键被忽略，不会报错），
#    但**写错字段名会让配置静默失效** —— 应用照常启动，而你填的密钥根本没被
#    读进去，症状是「接口报模型不可用 / ASR 鉴权失败」。新增变量时请先在
#    config.py 里加字段，再回来补这一行。
# ============================================================================

# ==================== 数据库 ====================
# 项目文档 6.1：所有开发人员连接云服务器上的统一 MySQL，禁止使用本地数据库。
# 开发机通过 SSH 隧道连接，因此 DB_HOST 是隧道本端，DB_PORT 是隧道映射端口。
# 完整连接串由 app/core/config.py 从下列各项拼接，不单独配置 DATABASE_URL，
# 以避免两处配置漂移。
#
# ⚠️ 隧道端口要与下面的 DB_PORT 对齐：本机 .env 用 3308，
#    3307 是云服务器侧 MySQL 的端口，两者不是同一个数：
#   ssh -L 3308:127.0.0.1:3307 <user>@<云服务器IP> -N
# 起没起用这个验：netstat -ano | grep 3308  →  有 LISTENING 才算通。
# 没起隧道时，一切连库操作都会失败（WinError 1225 / Can't connect to MySQL server），
# 此时「连库核对」类任务只能退回文件层面结论。
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=smart_scheduler_dev
DB_USER=<数据库用户名>
DB_PASSWORD=<数据库密码>

# 建立 MySQL 连接的超时（秒）。不设它时，隧道没起 / 云库不可达会让每个连接
# 尝试都等到操作系统 TCP 超时（Windows 上可长达 20 秒以上）。
DB_CONNECT_TIMEOUT=5

# 注：config.py 不读 DATABASE_URL 这个键，连接串由上面的 DB_* 拼出来
# （见 config.database_url）。写进来虽然不会报错（extra="ignore"），
# 但会让人误以为改了它就能换库，故仅作备忘保留：
# DATABASE_URL=mysql+asyncmy://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# ==================== 应用 ====================
APP_NAME=SmartScheduler
APP_ENV=dev
DEBUG=true

# SQL 回显开关，与 DEBUG 刻意解耦。
# 开启后 SQLAlchemy 会把 SQL 语句与参数打进日志，其中包含 sys_user.password
# 的 bcrypt 哈希。开发日志常被粘贴到群里求助，因此默认关闭。
SQL_ECHO=false

# ==================== JWT ====================
# 生成方式（不要手写短密钥）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 非 dev 环境下若长度不足 32 字符，config.py 会拒绝启动。
JWT_SECRET_KEY=<至少32字符的随机密钥>
JWT_ALGORITHM=HS256

# accessToken 有效期（分钟）
JWT_EXPIRE_MINUTES=30

# refreshToken 有效期（天）
JWT_REFRESH_EXPIRE_DAYS=7

# refreshToken 轮换宽限期（秒）。前端并发刷新时，旧 token 在此窗口内仍可换取
# 一次新 token（消费即失效，不可重放），避免用户被莫名登出。
JWT_REFRESH_GRACE_SECONDS=60

# ==================== Redis ====================
# refreshToken 白名单、登录失败计数、Agent 埋点指标的存储。
# 开发机通过 SSH 隧道连接，端口为隧道映射端口（非 Redis 真实端口）。
# 置为 false 时自动退化为进程内内存实现：功能完整，但服务重启后
# 已登录用户需重新登录（项目文档 13.1 演示应急预案）。
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=<Redis密码，无密码则留空>
REDIS_DB=0

# Redis 操作超时（秒）。埋点与白名单读写都必须走短超时，
# 否则 Redis 抖动会拖慢业务接口。
REDIS_SOCKET_TIMEOUT=0.5

# ==================== CORS ====================
# 项目文档 5.4：需允许 Web 前端 localhost 及小程序域名访问。
# 多个来源用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== 文件上传（音频 + 模块 9/10 通用校验） ====================
# 注意：图片链路**不走本项**，它有自己的 IMAGE_MAX_SIZE_MB（见下方模块 2 段）。
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# ==================== 密码哈希 ====================
# bcrypt cost。12 约需 200-300ms/次，生产保持 12；
# 测试环境可设为 4 以加速（见 tests/conftest.py）。
BCRYPT_ROUNDS=12

# ==================== AI 增强（可选） ====================
# 项目文档 4.4 模块 9：登录异常检测为可选增强，不影响主流程，默认关闭。
AI_RISK_ENABLED=false

# 连续登录失败多少次后临时锁定（仅 AI_RISK_ENABLED=true 时生效）
LOGIN_MAX_FAILURES=5

# 失败计数的滑动窗口（秒）。停止尝试 15 分钟后计数自动清零。
LOGIN_FAIL_WINDOW_SECONDS=900

# ============================================================================
# 模块 1 / 模块 2 引入的配置
# ----------------------------------------------------------------------------
# 以下变量原先写在两位负责人各自维护的临时 .env.example 中，合并进本文件。
# 未配置这些值时应用照常启动：模块 1/2 的接口会走到「模型不可用」的降级分支，
# 返回友好提示而不是崩溃。
# ============================================================================

# ==================== 认证开关（临时，待集成组接管）====================
# true：get_current_user 直接放行，不校验 Token，方便联调与自测。
# ⚠️ 三处注意：
#   1. 仅 APP_ENV=dev 允许为 true，非 dev 环境 config.py 会拒绝启动；
#   2. 每次放行都会打 WARNING 日志，避免「忘了关」却无人察觉；
#   3. **本模板默认 false**。模块负责人开发期用的是 true，但那只是各自的
#      本地 .env；把 true 写进模板会让每个新同学 clone 下来就是「无鉴权」状态。
#      模块 1/2 联调需要时，在本机 .env 里临时改为 true。
AUTH_BYPASS=false

# ==================== 视觉多模态模型（模块 2 摄像头空间感知）====================
# 推荐阿里云百炼通义千问 VL：与项目所用的阿里云 ECS 同生态，内网调用更快更省流量。
# base_url 与 model 名以阿里云百炼控制台最新文档为准。
VISION_MODEL_NAME=qwen-vl-max
VISION_API_KEY=<你的 API Key>
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 是否启用 LangChain 的 with_structured_output（结构化输出）。
# 若你的模型返回 400 报错提示不支持 tools / json_schema，把它改成 false，
# 系统会自动降级为「普通调用 + 手工 JSON 容错解析」，功能不受影响。
VISION_STRUCTURED_OUTPUT=true

# 单次模型调用超时（秒）。视觉任务比纯文本慢，建议不低于 30。
LLM_TIMEOUT=60

# SDK 层自动重试次数；仍失败则抛异常，由 service 层降级为友好提示。
LLM_MAX_RETRIES=1

# ==================== 空间感知策略参数（模块 2）====================
# 置信度阈值：低于该值时接口返回 needConfirm=true 并给出追问文案。
# 演示时若希望「必然触发追问」，把它调到 0.85 左右即可，无需改代码。
IMAGE_CONFIDENCE_THRESHOLD=0.75

# 注入 Prompt 的候选场地上限，防止 Prompt 超长。
IMAGE_SPACE_CANDIDATE_LIMIT=100

# 上传图片大小上限（MB）。
# 与上面的 MAX_UPLOAD_SIZE_MB 是**按媒体类型分工**，不是两套并行冲突：
#   本项    → 所有图片链路（image_storage 落盘校验 + utils.upload 的
#             validate_image_upload，模块 2 拍照/草图、模块 6 巡检照片）
#   上面那项 → 音频（模块 1 录音）与模块 9/10 通用上传
# 图片要送视觉模型，限制更紧以控制成本与延迟；录音时长天然更长，故 10MB。
# 改本项会同时作用于图片链路的两处校验，不会出现「同一张图两种判定」。
IMAGE_MAX_SIZE_MB=5

# 图片落盘目录（相对于 backend/）与对外访问前缀
IMAGE_UPLOAD_DIR=uploads
IMAGE_STORAGE_BASE_URL=/uploads

# 是否计算并返回场地空档时段；关掉则 availableTime 恒为空数组。
# 关闭可省一次预约数据查询。
IMAGE_ENABLE_AVAILABLE_SLOTS=true

# ==================== 语音识别（模块 1，百度短语音标准版）====================
# 百度智能云控制台 -> 产品服务「语音技术」-> 应用列表 -> 应用详情
BAIDU_APP_ID=<你的百度 AppID>
BAIDU_API_KEY=<你的百度 API Key>
BAIDU_SECRET_KEY=<你的百度 Secret Key>

# 识别模型：1537 普通话(含英文/数字，实测最稳)；1737 纯中文
ASR_MODEL_PID=1537

# 采样率，需与小程序录音参数对齐。
ASR_RATE=16000

# 识别音频最长秒数。
ASR_MAX_DURATION_S=60

# ==================== 口语格式化（模块 1，DeepSeek）====================
# https://platform.deepseek.com -> API keys 管理
DEEPSEEK_API_KEY=<你的 DeepSeek Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ==================== 代码仓库与本地 SSH（备忘，不是环境变量）====================
# 仓库地址（SSH）。本网络下 GitHub 的 HTTPS 会被重置，推送一律用 SSH：
#   git@github.com:Aurora-0813/Scheduling_Platform.git
#
# SSH 走 ssh.github.com:443 —— 实测 github.com 的 :22 与 :443 在不同时间各被封过一次，
# 而 ssh.github.com:443 是 GitHub 给「22 端口被封」的官方备用入口，通常不受影响。
# 配置写在 ~/.ssh/config 里（仓库中的 git@github.com:... 地址不用改，git 自动路由）：
#   Host github.com
#       HostName ssh.github.com
#       Port 443
#       User git
# 验证：ssh -T git@github.com  →  Hi <用户名>! You've successfully authenticated
#
# ⚠️ 追加于合并说明（2026-09-28）：HTTPS 被重置的情形不止一种。本次拉取代码时
#    github.com:443 做 TCP 握手即超时，而同一时刻 api.github.com 与
#    codeload.github.com 完全可达 —— 说明封禁是按 IP 而非按域名做的。
#    若 SSH 也不通，可改用 codeload 直接取压缩包（无需 git）：
#      curl -L -o repo.tar.gz \
#        https://codeload.github.com/Aurora-0813/Scheduling_Platform/tar.gz/refs/heads/main
