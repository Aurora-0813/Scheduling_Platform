# ============================================================================
# 环境变量模板
# ============================================================================
# 用法：复制本文件为 .env，填入真实值。
# .env 严禁提交至 Git 仓库（§3.5 / §8.6 / §9.4），本文件只放占位符。
# ============================================================================

# ==================== 数据库配置 ====================
# 本地通过 SSH 隧道连服务器 MySQL
# SSH 隧道命令：ssh -L 3308:127.0.0.1:3307 root@你的服务器IP -N
DB_HOST=<云服务器IP或隧道本地地址>
DB_PORT=3308
DB_NAME=smart_scheduler_dev
DB_USER=<数据库用户名>
DB_PASSWORD=<数据库密码>

# ==================== 应用配置 ====================
APP_NAME=SmartScheduler
APP_ENV=dev
DEBUG=true

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=<随机长字符串，禁止使用 123456 这类弱密钥>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ==================== 认证开关（临时，待集成组接管）====================
# true：get_current_user 直接放行，不校验 Token，方便联调与自测
# ⚠️ 部署与演示前必须改为 false
AUTH_BYPASS=true

# ==================== 视觉多模态模型（模块 2 摄像头空间感知）====================
# 推荐阿里云百炼通义千问 VL：与项目所用的阿里云 ECS 同生态，内网调用更快更省流量
# base_url 与 model 名以阿里云百炼控制台最新文档为准
VISION_MODEL_NAME=qwen-vl-max
VISION_API_KEY=<你的 API Key>
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 是否启用 LangChain 的 with_structured_output（结构化输出）
# 若你的模型返回 400 报错提示不支持 tools / json_schema，把它改成 false，
# 系统会自动降级为「普通调用 + 手工 JSON 容错解析」，功能不受影响
VISION_STRUCTURED_OUTPUT=true

# 单次模型调用超时（秒）。视觉任务比纯文本慢，建议不低于 30
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1

# ==================== 空间感知策略参数（模块 2）====================
# 置信度阈值：低于该值时接口返回 needConfirm=true 并给出追问文案
# 演示时若希望「必然触发追问」，把它调到 0.85 左右即可，无需改代码
IMAGE_CONFIDENCE_THRESHOLD=0.75
# 注入 Prompt 的候选场地上限，防止 Prompt 超长
IMAGE_SPACE_CANDIDATE_LIMIT=100
# 上传图片大小上限（MB）
IMAGE_MAX_SIZE_MB=5
# 图片落盘目录（相对于 backend/）与对外访问前缀
IMAGE_UPLOAD_DIR=uploads
IMAGE_STORAGE_BASE_URL=/uploads
# 是否计算并返回场地空档时段；关掉则 availableTime 恒为空数组
IMAGE_ENABLE_AVAILABLE_SLOTS=true
