# ============================================================================
# 环境变量模板
# ============================================================================
# 用法：复制本文件为 .env，填入真实值。
# .env 严禁提交至 Git 仓库（§3.5 / §8.6 / §9.4），本文件只放占位符。
#
# ⚠️ 这里只允许出现 app/core/config.py 里声明过的字段名。
#    Settings 默认 extra="forbid"，多写一个未声明的键会让应用启动直接抛
#    ValidationError。没有对应字段的说明一律用 # 注释掉，不要写成赋值。
# ============================================================================

# ==================== 数据库配置 ====================
# 所有开发人员连接云服务器上的统一 MySQL 库，禁止使用本地数据库。
# 本地通过 SSH 隧道连服务器 MySQL：连库前必须先起隧道（本机端口 → 云服务器 MySQL 端口）。
# ⚠️ 隧道端口要与下面的 DB_PORT 对齐：本机 .env 用 3308，
#    3307 是云服务器侧 MySQL 的端口，两者不是同一个数：
#   ssh -L 3308:127.0.0.1:3307 <user>@<云服务器IP> -N
# 起没起用这个验：netstat -ano | grep 3308  →  有 LISTENING 才算通。
# 没起隧道时，一切连库操作都会失败（WinError 1225 / Can't connect to MySQL server），
# 此时「连库核对」类任务只能退回文件层面结论。
DB_HOST=<云服务器IP或隧道本地地址>
DB_PORT=3308
DB_NAME=smart_scheduler_dev
DB_USER=<数据库用户名>
DB_PASSWORD=<数据库密码>

# 注：config.py 不读 DATABASE_URL 这个键，连接串由上面的 DB_* 拼出来
# （见 config.database_url / config.sync_database_url）。写进来反而会触发
# extra="forbid" 启动报错，所以仅作备忘保留：
# DATABASE_URL=mysql+asyncmy://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# ==================== 应用配置 ====================
APP_NAME=SmartScheduler
APP_ENV=dev
DEBUG=true

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=<随机长字符串，禁止使用 123456 这类弱密钥>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ==================== 认证开关（临时，待集成组接管）====================
# true：get_current_user 直接放行，不校验 Token，方便联调与自测
# ⚠️ 部署与演示前必须改为 false
AUTH_BYPASS=true

# ==================== 视觉多模态模型（模块 2 摄像头空间感知）====================
# 推荐阿里云百炼通义千问 VL：与项目所用的阿里云 ECS 同生态，内网调用更快更省流量
# base_url 与 model 名以阿里云百炼控制台最新文档为准
VISION_MODEL_NAME=qwen-vl-max
VISION_API_KEY=<你的 API Key>
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# 是否启用 LangChain 的 with_structured_output（结构化输出）
# 若你的模型返回 400 报错提示不支持 tools / json_schema，把它改成 false，
# 系统会自动降级为「普通调用 + 手工 JSON 容错解析」，功能不受影响
VISION_STRUCTURED_OUTPUT=true

# 单次模型调用超时（秒）。视觉任务比纯文本慢，建议不低于 30
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1

# ==================== 空间感知策略参数（模块 2）====================
# 置信度阈值：低于该值时接口返回 needConfirm=true 并给出追问文案
# 演示时若希望「必然触发追问」，把它调到 0.85 左右即可，无需改代码
IMAGE_CONFIDENCE_THRESHOLD=0.75
# 注入 Prompt 的候选场地上限，防止 Prompt 超长
IMAGE_SPACE_CANDIDATE_LIMIT=100
# 上传图片大小上限（MB）
IMAGE_MAX_SIZE_MB=5
# 图片落盘目录（相对于 backend/）与对外访问前缀
IMAGE_UPLOAD_DIR=uploads
IMAGE_STORAGE_BASE_URL=/uploads
# 是否计算并返回场地空档时段；关掉则 availableTime 恒为空数组
IMAGE_ENABLE_AVAILABLE_SLOTS=true

# ==================== 语音识别（模块 1，百度短语音标准版）====================
# 百度智能云控制台 -> 产品服务「语音技术」-> 应用列表 -> 应用详情
BAIDU_APP_ID=<你的百度 AppID>
BAIDU_API_KEY=<你的百度 API Key>
BAIDU_SECRET_KEY=<你的百度 Secret Key>
# 识别模型：1537 普通话(含英文/数字，实测最稳)；1737 纯中文
ASR_MODEL_PID=1537
ASR_RATE=16000
ASR_MAX_DURATION_S=60

# ==================== 口语格式化（模块 1，DeepSeek）====================
# https://platform.deepseek.com -> API keys 管理
DEEPSEEK_API_KEY=<你的 DeepSeek Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ==================== 代码仓库与本地 SSH（备忘，不是环境变量）====================
# 仓库地址（SSH）。本网络下 GitHub 的 HTTPS 会被重置，推送一律用 SSH：
#   git@github.com:Aurora-0813/Scheduling_Platform.git
#
# SSH 走 ssh.github.com:443 —— 实测 github.com 的 :22 与 :443 在不同时间各被封过一次，
# 而 ssh.github.com:443 是 GitHub 给「22 端口被封」的官方备用入口，通常不受影响。
# 配置写在 ~/.ssh/config 里（仓库中的 git@github.com:... 地址不用改，git 自动路由）：
#   Host github.com
#       HostName ssh.github.com
#       Port 443
#       User git
# 验证：ssh -T git@github.com  →  Hi <用户名>! You've successfully authenticated
