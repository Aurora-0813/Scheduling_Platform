# ==================== 数据库配置 ====================
# 本地通过 SSH 隧道连服务器 MySQL
# SSH 隧道命令：ssh -L 3308:127.0.0.1:3307 root@你的服务器IP -N
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=smart_scheduler_dev
DB_USER=smart_dev
DB_PASSWORD=123456

# ==================== 应用配置 ====================
APP_NAME=SmartScheduler
APP_ENV=dev
DEBUG=true

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=123456
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440